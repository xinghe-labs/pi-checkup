{
  "name": "pi-checkup",
  "version": "0.1.0",
  "description": "Health checks for your Pi setup: tool/command conflicts, broken packages, shadowed binaries, dead endpoints.",
  "type": "module",
  "license": "MIT",
  "author": "xinghe-labs",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi",
    "extension",
    "healthcheck",
    "diagnostics",
    "doctor",
    "troubleshooting"
  ],
  "pi": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "bin": {
    "pi-checkup": "./bin/checkup.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/index.js",
    "checkup": "node ./bin/checkup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinghe-labs/pi-checkup.git"
  },
  "bugs": {
    "url": "https://github.com/xinghe-labs/pi-checkup/issues"
  },
  "homepage": "https://github.com/xinghe-labs/pi-checkup#readme"
}
